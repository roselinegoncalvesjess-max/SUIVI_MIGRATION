{
  "name": "suivi-migration-server",
  "version": "1.0.0",
  "description": "API du suivi de la migration mSupply vers Open mSupply (LHSPLA)",
  "type": "module",
  "main": "src/index.js",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "node src/scripts/migrate.js",
    "init": "node src/scripts/init.js",
    "import": "node src/scripts/import.js",
    "reclasser": "node src/scripts/reclasser.js",
    "test": "node --test --test-concurrency=1 test/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.0",
    "pg": "^8.13.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
