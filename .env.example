# Copier ce fichier en .env puis modifier les valeurs.

# Base PostgreSQL (utilisée par docker compose)
POSTGRES_DB=suivi_migration
POSTGRES_USER=suivi
POSTGRES_PASSWORD=remplacer-ce-mot-de-passe

# Hors Docker, indiquer l'adresse complète de la base :
# DATABASE_URL=postgres://suivi:motdepasse@localhost:5432/suivi_migration

# Clé de signature des sessions : une longue chaîne aléatoire (ex. : openssl rand -hex 32)
JWT_SECRET=remplacer-par-une-longue-chaine-aleatoire

# Compte administrateur créé (ou réinitialisé) au démarrage
ADMIN_IDENTIFIANT=admin
ADMIN_MOT_DE_PASSE=remplacer-ce-mot-de-passe
